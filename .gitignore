# Browser session data (contains account cookies — never commit)
core/browser_session_sandbox/
core/browser_user_data/
_bak_user_data/

# Runtime screenshots
core/browser_screen_capture/

# Config and user data (contains account info)
data/config.json
data/user_login_lookup.json
data/*.json
data/*.log

# Logs and runtime files
*.log
core/*.json

# Python
__pycache__/
*.pyc
.venv/
.env

# Root-level test images (screenshots used for debugging — never commit)
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.bmp
/*.webp

# Anything holding accounts, cookies, or prompts
*secret*
*credential*
*_prompt*.json
prompts.json

# IDE
.vscode/

# Claude Code local settings
.claude/

# AI agent instruction / handoff files (local only, never commit)
CLAUDE.md
HANDOFF.md
AGENTS.md
